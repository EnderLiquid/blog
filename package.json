{
  "name": "blog",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run site:manifest && nuxt build",
    "content:check": "node scripts/validate-content.mjs",
    "dev": "node scripts/dev.mjs",
    "format": "prettier --write \"app/**/*.{ts,vue,css}\" \"public/**/*.css\" \"server/**/*.ts\" \"shared/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.{ts,mjs}\" \"*.{ts,json,md}\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"app/**/*.{ts,vue,css}\" \"public/**/*.css\" \"server/**/*.ts\" \"shared/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.{ts,mjs}\" \"*.{ts,json,md}\" \".github/**/*.yml\"",
    "generate": "npm run site:manifest && nuxt generate && pagefind --site .output/public",
    "preview": "nuxt preview",
    "site:manifest": "node scripts/build-site-manifest.mjs",
    "test:unit": "node --test tests/**/*.test.ts",
    "typecheck": "npm run site:manifest && nuxt typecheck"
  },
  "dependencies": {
    "@giscus/vue": "^3.1.1",
    "@nuxt/content": "^3.15.0",
    "better-sqlite3": "^12.11.1",
    "katex": "0.18.1",
    "nuxt": "^4.4.8",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "ufo": "1.6.4",
    "unified": "11.0.5",
    "v-viewer": "3.0.23",
    "vfile": "6.0.3",
    "viewerjs": "1.11.8",
    "vue": "^3.5.0",
    "vue-router": "^5.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.5",
    "shiki": "^4.3.1",
    "typescript": "^5.9.0",
    "vue-tsc": "^3.2.0",
    "yaml": "^2.9.0"
  }
}
